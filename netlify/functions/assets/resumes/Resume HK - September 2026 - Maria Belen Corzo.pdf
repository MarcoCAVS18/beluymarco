         <rms:rms_experience_0_description>Returning for a third vintage with the company, recognizing high performance and familiarity with site operations.</rms:rms_experience_0_description>
         <rms:rms_experience_0_isCurrent>true</rms:rms_experience_0_isCurrent>
         <rms:rms_experience_0_location>Blenheim, New Zealand</rms:rms_experience_0_location>
         <rms:rms_experience_0_role>Cellar Hand</rms:rms_experience_0_role>
         <rms:rms_experience_1_company>DEE VINE ESTATES WINERY</rms:rms_experience_1_company>
         <rms:rms_experience_1_dateBegin>January 2025</rms:rms_experience_1_dateBegin>
