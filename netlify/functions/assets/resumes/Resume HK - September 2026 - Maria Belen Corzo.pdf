         <rms:rms_experience_4_dateBegin>February 2022</rms:rms_experience_4_dateBegin>
         <rms:rms_experience_4_dateBeginFormat>January 2006</rms:rms_experience_4_dateBeginFormat>
         <rms:rms_experience_4_dateBeginTS>1643673600</rms:rms_experience_4_dateBeginTS>
         <rms:rms_experience_4_dateEnd>May 2022</rms:rms_experience_4_dateEnd>
         <rms:rms_experience_4_dateEndFormat>January 2006</rms:rms_experience_4_dateEndFormat>
         <rms:rms_experience_4_dateEndTS>1651363200</rms:rms_experience_4_dateEndTS>
         <rms:rms_experience_4_description>Gained foundational skills in vintage operations, assisting with red and white fermentation management.&#xA;Developed expertise in safe chemical handling, equipment setup, and general cellar hygiene.</rms:rms_experience_4_description>
         <rms:rms_experience_4_isCurrent>false</rms:rms_experience_4_isCurrent>
